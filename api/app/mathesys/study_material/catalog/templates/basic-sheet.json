{
  "id": "basic-sheet",
  "name": "Basic Sheet",
  "description": "Centered title and a thin footer over one open body. No logo, so the page stays open for the content.",
  "orientation": "portrait",
  "page": { "size": "Letter", "width_in": 8.5, "height_in": 11, "margin_in": 0.4 },
  "type": { "body_pt": 10.5, "title_pt": 26 },
  "disclaimer": "footer",
  "cut_lines": false,
  "sections": [
    {
      "id": "title",
      "label": "Title",
      "kind": "strict",
      "content": "title",
      "align": "center",
      "box": { "x": 0, "y": 0, "w": 100, "h": 5 }
    },
    {
      "id": "body",
      "label": "Body",
      "kind": "flexible",
      "allowed_types": ["text", "diagram", "image"],
      "max_components": 6,
      "box": { "x": 0, "y": 5, "w": 100, "h": 93 }
    },
    {
      "id": "footer",
      "label": "Footer",
      "kind": "strict",
      "content": "footer",
      "align": "center",
      "max_words": 20,
      "box": { "x": 0, "y": 98, "w": 100, "h": 2 }
    }
  ]
}
