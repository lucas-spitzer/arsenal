{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "app",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "api",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app",
      "rewrites": [
        { "source": "/api/:path(.*)?", "destination": "/:path" }
      ]
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arsenal-lucas-spitzers-projects.vercel.app" }],
      "destination": "https://www.atlas3.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arsenal-bice.vercel.app" }],
      "destination": "https://www.atlas3.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "arsenal-git-main-lucas-spitzers-projects.vercel.app" }],
      "destination": "https://www.atlas3.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
